# =============================================================
# frontend/.env  -  copie para .env e preencha
# =============================================================
# ATENÇÃO: tudo que começa com VITE_ vai para o bundle e fica visível no
# navegador. Aqui só entra chave PÚBLICA. Nunca a service_role nem a do Ollama.

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_KEY=sua_chave_publicavel_anon

# Opcional. Sem isto, o app fala com o mesmo host que abriu a página, na porta
# 8000 - o que faz o acesso pelo celular funcionar sem editar nada.
# VITE_API_URL=http://192.168.0.100:8000
