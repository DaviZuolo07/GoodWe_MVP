# =============================================================
# admin/.env  -  copie para .env e preencha
# =============================================================
# Endereço da API ADMINISTRATIVA (backend/main_admin.py).
# Sem isto, o painel fala com o mesmo host que abriu a página, na porta 8001.
# Publicado, aponte para o endereço da API administrativa:
# VITE_ADMIN_API_URL=https://admin-api.seudominio.com
#
# Este app NÃO usa Supabase nem a API pública do morador: não há mais nada
# para configurar aqui, e nenhuma chave entra neste arquivo.
#
# "Entrar com Google" para operadores de condomínio (opcional). O MESMO
# client id do GOOGLE_CLIENT_ID do backend/.env. Não é segredo (vai no
# navegador), mas só funciona nas origens autorizadas no Google Cloud.
# VITE_GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com
