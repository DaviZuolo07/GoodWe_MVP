# =============================================================
# totem_virtual/.env  -  copie este arquivo para .env e preencha
# =============================================================
# NUNCA comite o .env (o .gitignore da raiz já o ignora).
# A chave chega por canal privado, nunca por chat ou commit.

# Backend local (uvicorn main:app, de dentro de backend/)
BACKEND_URL=http://127.0.0.1:8000

# Saem de:  python provisionar.py placa-v2 --carregadores <v1>,<v2>,<v3>,<v4> --nome "Totem virtual"
# (rodado pelo Daniel). A ordem dos carregadores é a ordem das vagas 1..4.
DEVICE_ID=00000000-0000-0000-0000-000000000000
DEVICE_KEY_HEX=64_caracteres_hexadecimais

# --- Ritmo (opcional) -----------------------------------------
TOTEM_AMOSTRA_S=2            # uma leitura por vaga a cada N s
TOTEM_ENVIO_S=6              # um lote de telemetria a cada N s
TOTEM_OFFLINE_CORTE_S=120    # sem servidor por N s, os relés abrem
PAINEL_PORTA=8765

# --- Modo roteiro ----------------------------------------------
# UIDs em hexa. Cenário sem a tag dele aparece como PULADO.
TAG_A=                       # morador com saldo
TAG_B=                       # outro morador com saldo
TAG_SEM_SALDO=               # morador com saldo zero
TAG_DESCONHECIDA=            # opcional: tag de outro condomínio (padrão: um UID inexistente)

# Opcional: duas contas do app, na MESMA ordem de TAG_A e TAG_B, para o cenário
# "recarga preparada no app" (o único jeito de carregar enquanto o Totem v2.1
# não entra no backend). Cada conta precisa de um veículo do tipo celular.
# Use contas de teste: a senha fica em texto neste arquivo.
APP_CONTAS=                  # Nome Um:senha1,Nome Dois:senha2

# Quanto esperar o backend reagir a celular desplugado / cheio / vaga vazia.
ROTEIRO_ESPERA_S=90
