# =============================================================
# backend/.env  -  copie este arquivo para .env e preencha
# =============================================================
# NUNCA comite o .env. Se alguma destas chaves já circulou em zip,
# e-mail ou grupo, ROTACIONE antes de apresentar.

# --- Supabase -------------------------------------------------
SUPABASE_URL=https://seu-projeto.supabase.co
# O BACKEND precisa da chave SECRETA (sb_secret_... ou service_role).
# Com a chave publicável o RLS devolve tudo vazio e o backend recusa subir.
SUPABASE_KEY=sb_secret_sua_chave_secreta
# Chave PÚBLICA (a mesma do frontend). Usada só por `provisionar.py verificar`.
SUPABASE_ANON_KEY=sua_chave_publicavel

# --- Identidade (JWT próprio) ---------------------------------
# Gere com:  python provisionar.py chave-jwt
# e importe a chave PÚBLICA no Supabase (Settings -> JWT Keys).
JWT_PRIVATE_JWK={"kty":"EC","kid":"...","crv":"P-256","d":"...","x":"...","y":"..."}
JWT_TTL_MIN=120

# --- Painel do gestor (API administrativa, ADR-023) -------------
# O painel é OUTRO app, servido por `uvicorn main_admin:app --port 8001`.
# Segundo fator (app autenticador). Gere a chave com:
#   python provisionar.py chave-mfa
# e cadastre cada gestor com:
#   python provisionar.py gestor-mfa --nome "Nome do Gestor"
ADMIN_MFA_KEY=
# obrigatorio = gestor sem segundo fator não entra (padrão em produção).
# opcional    = quem não cadastrou entra só com a senha (bancada).
# ADMIN_MFA=obrigatorio
# Validade do token do painel, em minutos (o do morador é JWT_TTL_MIN).
ADMIN_JWT_TTL_MIN=30
# Opcional: chave separada para o token do painel (python provisionar.py chave-jwt-admin).
# ADMIN_JWT_PRIVATE_JWK=
# Origens do PAINEL liberadas no CORS da API administrativa. Nunca repita aqui
# uma origem de FRONTEND_ORIGINS: são endereços diferentes de propósito.
ADMIN_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# --- ESP32, protocolo v2 (ADR-015) -----------------------------
# Chave-mestra das placas v2. A chave de cada placa é DERIVADA desta e
# nunca é gravada no banco. Gere com:  python provisionar.py chave-mestra
# Trocar esta chave invalida TODAS as placas v2. Sem ela, só o v1 funciona
# (as rotas /hardware/v2 respondem 503).
DEVICE_MASTER_KEY=64_caracteres_hexadecimais
# Tolerância de relógio entre placa e servidor, em segundos (anti-replay).
JANELA_REPLAY_S=120

# --- Assistente de IA (Ollama) --------------------------------
CHAT_MODO=llm                      # llm | regras  (regras = botão de pânico)
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=sua_chave_ollama
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_TIMEOUT_S=30
OLLAMA_THINK=low                   # low | medium | high | none
OLLAMA_DEV=1                       # recarrega os prompts .md sem reiniciar

# --- Operação -------------------------------------------------
# desenvolvimento (padrão) | producao
# producao: desliga /docs e /openapi.json, desliga o CORS automático de rede
# local (vale só o que está em FRONTEND_ORIGINS / ADMIN_ORIGINS), liga HSTS e
# torna o segundo fator do gestor obrigatório.
AMBIENTE=desenvolvimento
# Quantos proxies confiáveis existem na frente do backend. 0 na rede local;
# 1 na maioria das hospedagens (Render, Railway, Fly, Nginx/Caddy próprio).
# Sem isto, publicado, o limite de tentativas por IP vira um limite GLOBAL.
PROXIES_CONFIAVEIS=0
# Código de convite exigido no cadastro. Vazio = cadastro aberto. Defina antes
# de publicar: sem ele qualquer script cria contas e gasta a cota do assistente.
CODIGO_CADASTRO=

# Origens do frontend liberadas no CORS (separadas por vírgula).
# Para abrir no celular, acrescente o IP que o Vite mostra.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 1 = suspende a varredura de ESP32 offline e LIBERA as rotas /debug.
# Deixe 0 com a placa conectada e na gravação.
MODO_DEMO=0

FUSO_HORARIO=America/Sao_Paulo
